# Copy this file to `.env` and fill in your credentials.
# Never commit your real `.env` to version control.
# The server reads these variables via src/config.py (prefix X_API_).

# OAuth 1.0a (User context) — required for posting
X_API_API_KEY=
X_API_API_KEY_SECRET=
X_API_ACCESS_TOKEN=
X_API_ACCESS_TOKEN_SECRET=

# OAuth 2.0 (User context via 3‑legged flow) — optional, not required for OAuth1 posting
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=

# App-only bearer token (public read-only)
X_API_APP_BEARER_TOKEN=
